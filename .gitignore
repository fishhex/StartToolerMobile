# ============================================================
# StartTooler Mobile — 仓库统一 .gitignore
# 覆盖所有子模块（flutter/、doc/ 等）。
# 路径以仓库根为基准。
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE ----------
# IntelliJ / Android Studio
.idea/
**/*.iml
**/*.ipr
**/*.iws
# VS Code（按需启用）
.vscode/
# Xcode
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
DerivedData/
# 其它
**/*.swp
**/*.swo
**/.*~
**/.history/

# ---------- 通用 VCS / 包管理器目录 ----------
**/.atom/
**/.svn/
**/.swiftpm/
**/.build/
**/.buildlog/
**/.history

# ---------- 语言/构建通用产物 ----------
**/.log
**/*.log
**/*.pyc
**/*.class
**/*.o
**/*.obj
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.pdb
**/build/
**/out/
**/dist/
**/.gradle/
**/captures/
**/.cxx/
**/migrate_working_dir/

# ---------- Android 特定 ----------
# Gradle wrapper 脚本（仓库使用系统 gradlew 时忽略；如要纳入请注释下一行）
**/gradlew
**/gradlew.bat
# Android Studio 生成的构建产物
**/android/app/debug
**/android/app/profile
**/android/app/release

# ---------- Flutter API 文档（自动生成） ----------
**/doc/api/

# ---------- 密钥 / 本地配置 ----------
.env
.env.*
!**/.env.example
**/*.keystore
**/*.jks
**/key.properties
**/local.properties
**/secrets/

# ---------- Node（doc 中可能的脚本依赖） ----------
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ---------- Flutter / Dart / Pub ----------
# Dart 工具链
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.flutter-plugins
# Pub 缓存
**/.pub-cache/
**/.pub/
# iOS 上 Flutter 的临时标记
**/ios/Flutter/.last_build_id
# 覆盖率与符号化
**/coverage/
**/app.*.symbols
**/app.*.map.json

# ---------- Android 特定（补充） ----------
# 插件注册代码（每次构建重新生成）
**/GeneratedPluginRegistrant.java
# Gradle wrapper jar 需要保留
!**/gradle/wrapper/gradle-wrapper.jar
# 上面 Android 段已声明 gradlew/gradlew.bat 与 android/app build 目录

# ---------- 临时 / 备份 ----------
**/*.bak
**/*.tmp
**/*.orig
**/*.rej
**/.tmp/
**/.cache/

# ---------- 本项目私有的占位/运行时目录 ----------
{{pkgetc}}/
{{etc}}/
